{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 (MSVC + Ninja)",
      "description": "Configure for 64-bit Windows using MSVC toolset and Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux x64 (GCC + Ninja)",
      "description": "Configure for 64-bit Linux using GCC and Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS Universal (AppleClang + Ninja)",
      "description": "Configure for macOS (Intel / Apple Silicon) using Clang and Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-clang",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-test",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "linux-test",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "macos-test",
      "configurePreset": "macos-clang"
    }
  ]
}

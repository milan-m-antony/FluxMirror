#include <winuser.h>

0 ICON "data/icon.ico"
1 RT_MANIFEST "scrcpy-windows.manifest"
2 VERSIONINFO
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "FileDescription", "FluxMirror - Native Android Screen Mirror & Controller"
      VALUE "InternalName", "FluxMirror"
      VALUE "LegalCopyright", "Flux Systems"
      VALUE "OriginalFilename", "FluxMirror.exe"
      VALUE "ProductName", "FluxMirror"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
